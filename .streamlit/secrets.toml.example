# ────────────────────────────────────────────────────────────────
# Google AI Studio에서 발급받은 Gemini API 키를 여기에 입력하세요.
#  1) https://aistudio.google.com/app/apikey 접속
#  2) "Create API key" 클릭 → 키 복사
#  3) 이 파일을 `.streamlit/secrets.toml` 로 복사한 뒤 키 붙여넣기
#  4) 실행:  streamlit run app.py
# ────────────────────────────────────────────────────────────────
GEMINI_API_KEY = "여기에_발급받은_키_붙여넣기"

# (선택) 사용할 모델. 환경변수 GEMINI_MODEL 로도 덮어쓸 수 있습니다.
# 기본값은 gemini-2.5-flash — 2026-07 기준 가장 빠르고 안정적인 다중모달 모델.
# 다른 빠른 옵션: gemini-2.5-flash-lite, gemini-2.0-flash
# GEMINI_MODEL = "gemini-2.5-flash"
