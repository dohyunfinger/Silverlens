# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
NEXT_PUBLIC_DIALECT_API_URL=
DIALECT_MODEL_ID=

# Firebase Authentication (Firebase Console > Project settings > Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Use a cryptographically random value of at least 32 characters.
AUTH_SESSION_SECRET=

# Temporary caregiver admin login. Keep disabled outside short-lived testing.
TEMP_ADMIN_LOGIN_ENABLED=false
TEMP_ADMIN_USERNAME=
TEMP_ADMIN_PASSWORD=
