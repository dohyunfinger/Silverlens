# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
NEXT_PUBLIC_DIALECT_API_URL=
DIALECT_MODEL_ID=

# Firebase Authentication (Firebase Console > Project settings > Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Use a cryptographically random value of at least 32 characters.
AUTH_SESSION_SECRET=

# 식품의약품안전처 의약품 낱알식별 정보 동기화용 (공공데이터포털 일반 인증키)
# 배포 런타임에는 필요하지 않으며 `npm run sync:drug-data` 실행 때만 사용합니다.
MFDS_DATA_API_KEY=
