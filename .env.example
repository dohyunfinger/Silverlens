# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
NEXT_PUBLIC_DIALECT_API_URL=
DIALECT_MODEL_ID=

# ElevenLabs 나레이션 (선택). 키가 없거나 실패하면 Gemini TTS를 씁니다.
# Voice Library 목소리는 유료 요금제(Starter 이상)에서만 API로 쓸 수 있습니다.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# 비우면 한국어는 Anna Kim(uyVNoMrnUku1dZyVEXwD), 영어·일본어는 Gemini를 씁니다.
ELEVENLABS_VOICE_ID_KO=
# 무료 요금제라 위 목소리를 못 쓸 때 대신 쓸 기본 목소리. 비우면 Sarah(EXAVITQu4vr4xnSDxMaL).
ELEVENLABS_FREE_VOICE_ID_KO=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_JA=

# 식품의약품안전처 의약품 낱알식별 정보용 (공공데이터포털 일반 인증키)
# 배포에서는 Cloudflare Secret으로 저장하며 예약 작업이 D1을 갱신합니다.
# 로컬에서는 `npm run sync:drug-data`로 JSON 보조 데이터를 만들 때도 사용합니다.
MFDS_DATA_API_KEY=
